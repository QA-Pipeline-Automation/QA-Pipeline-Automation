{
  "name": "pipeline-start",
  "nodes": [
    {
      "parameters": {
        "command": "cd /tests-api && NODE_NO_WARNINGS=1 /home/node/.npm-global/bin/newman run \"API Tests.postman_collection.json\" -e \"Dev - Juice Shop.postman_environment.json\" --env-var baseUrl=http://host.docker.internal:3000 --reporters json --reporter-json-export results.json > /dev/null 2>&1 ; cat results.json"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -1456,
        96
      ],
      "id": "0ccb398f-e181-437e-8304-1e6aec49aa9a",
      "name": "Execute Command  Newman",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "node -e \"\nconst http = require('http');\nconst req = http.request({\n  hostname: 'qa_cypress',\n  port: 4000,\n  path: '/run-tests',\n  method: 'POST',\n  timeout: 600000\n}, (res) => {\n  let data = '';\n  res.on('data', chunk => data += chunk);\n  res.on('end', () => {\n    console.error('Status:', res.statusCode);\n    console.log(data);\n  });\n});\nreq.on('error', (e) => console.error('Error:', e.message));\nreq.on('timeout', () => { console.error('Timeout'); req.destroy(); });\nreq.end();\n\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -928,
        96
      ],
      "id": "73f65794-ee07-485a-8ce5-3c6e9b0f7188",
      "name": "Execute Command  Cypress",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nconst report = JSON.parse(raw);\n\nreturn [{\n  json: {\n    totalTests: report.stats.tests,\n    passed: report.stats.passes,\n    failed: report.stats.failures,\n    passPercent: report.stats.passPercent,\n    duration: report.stats.duration,\n    startedAt: report.stats.start,\n    // On extrait uniquement les tests en échec avec leur message d'erreur,\n    // c'est ce qui nourrira le futur prompt d'analyse IA\n    failedTests: report.results.flatMap(file =>\n      file.suites.flatMap(suite =>\n        suite.tests\n          .filter(test => test.state === 'failed')\n          .map(test => ({\n            spec: file.file,\n            title: test.title,\n            errorMessage: test.err?.message || 'Erreur non spécifiée'\n          }))\n      )\n    )\n  }\n}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        96
      ],
      "id": "3d8b6114-7f38-4884-a052-98f5310d054f",
      "name": "Json Cypress"
    },
    {
      "parameters": {
        "jsCode": "// On récupère le texte stdout généré par Newman\nconst output = $input.first().json.stdout;\n\n// On parse la chaîne JSON\nconst report = JSON.parse(output);\n\nconst assertions = report.run.stats.assertions;\nconst requests = report.run.stats.requests;\n\nreturn {\n  json: {\n    status: assertions.failed === 0 ? \"PASSED\" : \"FAILED\",\n    totalAssertions: assertions.total,\n    failedAssertions: assertions.failed,\n    passedAssertions: assertions.total - assertions.failed,\n    totalRequests: requests.total,\n    failedRequests: requests.failed,\n    durationMs: report.run.timings.completed - report.run.timings.started\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1184,
        96
      ],
      "id": "5235daad-32fd-4a2e-ace0-ca0816d8e4e3",
      "name": "Json Newman"
    },
    {
      "parameters": {
        "jsCode": "// 1. Récupération des données extraites des nœuds précédents\n// (Ajuste les noms de nœuds s'ils diffèrent dans ton workflow)\nconst cypressData = $(\"Json Cypress\").first().json;\nconst newmanData = $(\"Json Newman\").first().json;\n\n// 2. Extraction des échecs Cypress (UI)\nconst uiFailures = cypressData.failedTests || [];\nconst uiHasFailures = cypressData.failed > 0 || uiFailures.length > 0;\n\n// 3. Extraction des échecs Newman (API)\n// En fonction de la structure envoyée par Json Newman (ex: assertions échouées)\nconst apiFailures = newmanData.failedTests || newmanData.failures || [];\nconst apiHasFailures = (newmanData.failed > 0) || apiFailures.length > 0;\n\n// 4. Calcul du statut global\nconst hasFailures = uiHasFailures || apiHasFailures;\n\n// 5. Structure du JSON unifié transmis au nœud suivant (IF / OpenAI)\nreturn [{\n  json: {\n    hasFailures: hasFailures,\n    summary: {\n      totalApiFailed: newmanData.failed || apiFailures.length,\n      totalUiFailed: cypressData.failed || uiFailures.length,\n      executionDate: new Date().toISOString()\n    },\n    details: {\n      apiFailures: apiFailures,\n      uiFailures: uiFailures\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
