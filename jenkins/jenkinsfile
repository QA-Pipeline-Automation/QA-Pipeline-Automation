pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                checkout scm
            }
        }
        stage('Build Test') {
            steps {
                echo 'Exécution du build de validation...'
                sh 'echo "Build réussi sur le container Jenkins!"'
            }
        }
    }
    
    post {
        always {
            echo 'Fin de l execution du Pipeline.'
        }
    }
}