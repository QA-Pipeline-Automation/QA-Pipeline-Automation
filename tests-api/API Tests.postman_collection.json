          "raw": "{\r\n  \"cid\": \"C1\",\r\n  \"orderLines\": [\r\n    {\r\n      \"productId\": 12,\r\n      \"quantity\": 10000,\r\n      \"customerReference\": \"PO00000001.2\"\r\n    }\r\n  ]\r\n}"
